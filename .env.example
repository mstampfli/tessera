# Copy to .env and adjust. Secrets belong here (or the real environment), never
# in a committed config file.

# Postgres connection URL. Matches the docker-compose dev database.
DATABASE_URL=postgres://tessera:tessera@127.0.0.1:5432/tessera

# Password source for `tesserad user create` / `user set-password`. Optional;
# if unset, the CLI reads the password from stdin.
# TESSERA_ADMIN_PASSWORD=change-me

# Optional overrides (TESSERA__<section>__<key>):
# TESSERA__SERVER__BIND=127.0.0.1:8080
# TESSERA__SERVER__SECURE_COOKIES=false
# TESSERA__LOG__FORMAT=pretty

# On this host, the shell DOCKER_HOST points at a dead podman socket; the real
# Docker daemon is here. Uncomment to make `docker` / `docker compose` work.
# DOCKER_HOST=unix:///var/run/docker.sock
