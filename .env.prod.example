# Copy to .env on the production host. Never commit the real .env.

# A strong Postgres password (the DB has no host port; still, set a real one).
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Bind the published ports to this host's tailnet IP so they are reachable by the
# hub's Caddy proxy but not on any public or LAN interface. Loopback by default.
APP_BIND=127.0.0.1

# Pin the compose file so a bare `docker compose up` cannot use the dev file.
COMPOSE_FILE=docker-compose.prod.yml

# --- Provider selection ---------------------------------------------------

# Default: the backend reaches a host Ollama for embeddings and generation.
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDER=ollama

# cp1 (CPU-only, no Ollama): build in-process ONNX embeddings and use the claude
# CLI for generation. Uncomment and rebuild with --build-arg.
# BACKEND_FEATURES=fastembed
# EMBEDDER=fastembed
